ini_close();
ap_profile_load();
window_set_fullscreen(global.fullscreen);

if (global.borderless == true)
    window_set_showborder(false);
else
    window_set_showborder(true);

display_reset(0, global.vsync);

if (!instance_exists(obj_dj))
    instance_create_layer(0, 0, "Overlay", obj_dj);

if (!instance_exists(obj_mouse))
    instance_create_layer(0, 0, "Overlay", obj_mouse);

if (!instance_exists(obj_gamepad_manager))
    instance_create_layer(0, 0, "Overlay", obj_gamepad_manager);

global.gamestart_ind = 0;
global.mutemusic = false;
global.music_mod = 1;
global.paused = 0;
global.facing_boss = "none";
global.memorygrabbed = "None";
global.rpgmaker = false;
global.rpg_x = -999;
global.rpg_y = -999;
global.footstepsnd = global.sounds.snd_test_footstep;
global.willingly_ended_run = 0;
global.gamemode = "normal";
global.get_cur_seed = 0;
global.killed_by = "";
global.selected_suit = "default";

if (global.pixelperfect == true)
    surface_resize(application_surface, global.screenw, global.screenh);
else
    surface_resize(application_surface, 1920, 1080);

setup_damage_vars();
scr_deathscreenstats();
scr_init_skills();
alarm[0] = 10;
handle_mods();
