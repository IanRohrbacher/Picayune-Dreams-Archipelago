function scr_save_settings()
{
    log("save settings -> " + global.save_options);
    ini_open(global.save_options);
    ini_write_real("options", "musvol", global.musvol);
    ini_write_real("options", "sndvol", global.sndvol);
    ini_write_real("options", "mastervol", global.master_vol);
    ini_write_real("options", "weaponhitvol", global.weapon_hit_vol);
    ini_write_real("options", "dialogvol", global.dialog_vol);
    ini_write_real("options", "ae_bitcrush", global.ae_bitcrush);
    ini_write_real("options", "ae_reverb", global.ae_reverb);
    ini_write_real("options", "ae_highpass", global.ae_highpass);
    ini_write_real("options", "mutenofocus", global.mutenofocus);
    ini_write_real("options", "vsync", global.vsync);
    ini_write_real("options", "fullscreen", global.fullscreen);
    ini_write_real("options", "screenshake", global.screenshake);
    ini_write_real("options", "hitflash", global.hitflash);
    ini_write_real("options", "pixelperfect", global.pixelperfect);
    ini_write_real("options", "lowhpeff", global.lowhpeff);
    ini_write_real("options", "autoupgrade", global.autoupgrade);
    ini_write_real("options", "autoupgrade_owned", global.autoupgrade_owned);
    ini_write_real("options", "autoupgrade_highest", global.autoupgrade_highest);
    ini_write_real("options", "disable3D", global.disable3D);
    ini_write_real("options", "show_circle_always", global.show_circle_always);
    ini_write_real("options", "xp_cans_enabled", global.xp_cans);
    ini_write_real("options", "borderless", global.borderless);
    ini_write_real("options", "dialogspd", global.dialogspd);
    ini_write_real("options", "auto_antilag", global.auto_antilag);
    ini_write_real("options", "manual_antilag", global.manual_antilag);
    ini_write_real("options", "autoalpha", global.autoalpha);
    ini_write_real("options", "autoaim_mouse", global.autoaim_mouse);
    ini_write_real("options", "autoaim_gamepad", global.autoaim_gamepad);
    ini_write_real("options", "kb_up", global.kb_up);
    ini_write_real("options", "kb_down", global.kb_down);
    ini_write_real("options", "kb_left", global.kb_left);
    ini_write_real("options", "kb_right", global.kb_right);
    ini_write_real("options", "kb_tiptoe", global.kb_tiptoe);
    ini_write_real("options", "kb_bomb", global.kb_bomb);
    ini_write_real("options", "kb_pause", global.kb_pause);
    ini_write_real("options", "kb_togaa", global.kb_togaa);
    ini_write_real("options", "kb_tabmen", global.kb_tabmen);
    ini_write_real("options", "kb_accept", global.kb_accept);
    ini_write_real("options", "kb_ff", global.kb_ff);
    ini_write_real("options", "kb_changesong", global.kb_changesong);
    ini_write_real("options", "weapon_trans", global.weapon_trans);
    ini_write_real("options", "xp_scalemod", global.xp_scalemod);
    ini_write_real("options", "bg_alpha", global.bg_alpha);
    ini_write_real("options", "permahitbox", global.permahitbox);
    ini_write_real("options", "gp_up", global.gpd_up);
    ini_write_real("options", "gp_down", global.gpd_down);
    ini_write_real("options", "gp_left", global.gpd_left);
    ini_write_real("options", "gp_right", global.gpd_right);
    ini_write_real("options", "gp_tiptoe", global.gpd_tiptoe);
    ini_write_real("options", "gp_bomb", global.gpd_bomb);
    ini_write_real("options", "gp_pause", global.gpd_pause);
    ini_write_real("options", "gp_togaa", global.gpd_togaa);
    ini_write_real("options", "gp_accept", global.gpd_accept);
    ini_write_real("options", "gp_tabmen", global.gpd_tabmen);
    ini_write_real("options", "gp_sens", global.gpd_sens);
    ini_write_real("options", "gp_ff", global.gpd_ff);
    ini_write_real("options", "gp_changesong", global.gpd_changesong);
    ini_write_real("options", "gp_deadzone", global.gp_deadzone);
    ini_write_real("options", "gp_allowmouse", global.gp_allowmouse);
    ini_write_real("options", "gp_dpadupg", global.gp_dpadupg);
    ini_write_real("options", "gp_autoaimdeadzone", global.gp_autoaimdeadzone);
    ini_write_real("options", "discontrol", global.discontrol);
    ini_close();
}
