    ini_write_real("stat_track", "stat_suit_spammer_overdrive", stat_suit_spammer_overdrive);
    ini_write_real("stat_track", "stat_suit_elemental_mortality", stat_suit_elemental_mortality);
    ini_write_real("stat_track", "stat_suit_elemental_overdrive", stat_suit_elemental_overdrive);
    
    save_damage_stats();
    // The slot's Archipelago details and stats are saved with the progress.
    ap_profile_save_meta();
    ini_close();
}
